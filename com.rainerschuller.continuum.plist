<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rainerschuller.continuum</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-m</string>
        <string>continuum.cli</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/rainerschuller/Code/Private/continuum</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd startet mit minimalem PATH; claude liegt in ~/.local/bin. -->
        <key>PATH</key>
        <string>/Users/rainerschuller/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONPATH</key>
        <string>/Users/rainerschuller/Code/Private/continuum</string>
    </dict>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/rainerschuller/.local/state/continuum/continuum.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rainerschuller/.local/state/continuum/continuum.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
